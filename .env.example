# Copier ce fichier en .env (ignoré par Git) et adapter les valeurs.
# Lu automatiquement par "docker compose" ET par Spring Boot (voir application.yaml) :
# une seule fois à remplir, jamais d'export ni de réglage dans IntelliJ.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
SHOPLOC_IDENTITY_CLIENT_SECRET=123

# Ton PostgreSQL local (propre à ta machine, à adapter) :
DB_USERNAME=postgres
DB_PASSWORD=
